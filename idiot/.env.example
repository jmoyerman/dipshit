# Copy this file to .env and set values for your idiot.
# .env is local configuration and must not be committed.

# Path to the llama.cpp command-line executable.
# Linux example: /home/youruser/llama.cpp/build/bin/llama-cli
# Windows example: C:\path\to\llama.cpp\llama-cli.exe
DIPSHIT_LLAMA=llama-cli

# Path to the GGUF model file.
# Linux example: /home/youruser/models/Qwen3-1.7B-Q4_K_M.gguf
# Windows example: C:\path\to\models\Qwen3-1.7B-Q4_K_M.gguf
DIPSHIT_MODEL=/path/to/Qwen3-1.7B-Q4_K_M.gguf

# WebSocket endpoint of the D.I.P.S.H.I.T. moderator.
DIPSHIT_MODERATOR=ws://moderator-host:8080/ws/idiot

# Name shown to the room. If omitted, the machine hostname is used.
DIPSHIT_NAME=YOUR_IDIOT_NAME

# Optional update branch/ref. Omit this line to track main.
DIPSHIT_UPDATE_REF=main

# Optional runtime/personality settings. These are the built-in defaults.
DIPSHIT_CTX_SIZE=4096
DIPSHIT_CURIOSITY=75
DIPSHIT_FRIENDLINESS=50
DIPSHIT_SOCIABILITY=25
